{
  "name": "remote-pc-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Windows companion for the Remote PC iPhone app: Claude Code, OpenCode, files, clipboard, apps, windows and tasks over Tailscale.",
  "type": "module",
  "bin": {
    "remote-pc-agent": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js start",
    "pair": "node dist/index.js pair",
    "dev": "tsx src/index.ts start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke:windows": "node scripts/smoke-windows.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "^1.19.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
